# Copy to .env.local to connect the "Run" button to a Qiskit backend (qamposer-backend).
# Leave unset to run every simulation in the browser.
#
# Start the backend (in the qamposer-backend repo):
#   uv sync
#   uv run uvicorn backend.main:app --host 0.0.0.0 --port 8080 --reload
#
# After editing this file, restart `pnpm dev` (Vite reads env vars only at startup).
# The backend must allow this app's origin via its CORS_ORIGINS setting
# (default: ["http://localhost:5173"]).
VITE_QISKIT_BACKEND_URL=
